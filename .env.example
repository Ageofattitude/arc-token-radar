# Arc JSON-RPC endpoint. Optional: defaults to the public Arc mainnet RPC.
ARC_RPC_URL=
# Bitquery API access token for indexed market data (trades, holders). Server-side only.
BITQUERY_API_KEY=
BITQUERY_GRAPHQL_URL=https://streaming.bitquery.io/graphql

# Scanner tuning (all optional)
# SCANNER_ENABLED=true
# SCAN_INTERVAL_MS=30000
# SCAN_LOOKBACK_HOURS=6
# SCAN_CONFIRMATIONS=2
# SCAN_CHUNK_BLOCKS=2000
# SCAN_MAX_CHUNKS_PER_CYCLE=12
# RPC_MIN_INTERVAL_MS=400
# REFRESH_WINDOW_HOURS=48
# MAX_REFRESH_PER_CYCLE=25
# NEW_TOKEN_LIVE_LAG_MINUTES=15
# API_PORT=3001
# DATA_DIR=data

# --- Vercel / serverless deployment (all optional) ---
# Durable state: an Upstash Redis database (Vercel Marketplace adds these automatically). Without it, results live
# only in one warm function instance and are recomputed on demand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Authorises GET /api/cron (Vercel Cron sends it as a Bearer token). Without it, scheduled scans are disabled.
# CRON_SECRET=
# SCAN_BUDGET_MS=40000
# SCAN_COOLDOWN_MS=20000
# SERVERLESS_FRESH_MS=300000
